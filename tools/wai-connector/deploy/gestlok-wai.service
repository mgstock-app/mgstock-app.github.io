# Private, dedicated Linux host only. Install under a restricted service user.
# Never run two workers with the same credentials/session directories.
[Unit]
Description=GESTLOK WAI - prueba aislada
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=gestlok-wai
Group=gestlok-wai
Environment=HOME=/var/lib/gestlok-wai
WorkingDirectory=/opt/gestlok-wai
ExecStart=/usr/bin/node /opt/gestlok-wai/connector.mjs
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
UMask=0077
StateDirectory=gestlok-wai
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/gestlok-wai
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
